+
+function generate() {
+  const err = $("#gen-error");
+  if (!notes.value.trim()) {
+    err.textContent = "Paste the clinical data in step 1 first.";
+    err.hidden = false;
+    notes.ta.focus();
+    return;
+  }
+  const bad = problems();
+  if (bad.length) {
+    err.textContent =
+      "Personal information is still present. Remove it (or mark it as not personal) before generating.";
+    err.hidden = false;
+    bad[0].ta.scrollIntoView({ behavior: "smooth", block: "center" });
+    bad[0].ta.focus();
+    return;
+  }
+  err.hidden = true;
