+  font-weight: 600;
+  color: var(--ok);
+}
+
+footer {
+  max-width: 980px;
+  margin: 0 auto;
+  padding: 0 20px 40px;
+  color: var(--muted);
+  font-size: 0.85rem;
+}
+
+@media (max-width: 720px) {
+  .dx-row {
+    grid-template-columns: 1fr 1fr;
+  }
+  .dx-row .name {
+    grid-column: 1 / -1;
+  }
+  .finding {
+    grid-template-columns: 1fr;
+  }
+  .doc {
+    padding: 18px;
+  }
+  .tone-marks {
+    padding: 0 40px;
+  }
+}
+
+@media print {
+  body {
+    background: #fff;
+  }
+  .top,
+  main > .card:not(#output-card),
+  footer,
+  .out-head,
+  .stale,
+  .out-warn,
+  .toast,
+  .muted,
+  .skip {
+    display: none !important;
+  }
+  main {
+    padding: 0;
+    max-width: none;
+  }
+  #output-card {
+    border: none;
+    box-shadow: none;
+    padding: 0;
+  }
+  .doc {
+    border: none;
+    padding: 0;
+    font-size: 12pt;
+  }
+  @page {
+    margin: 18mm;
+  }
+}
