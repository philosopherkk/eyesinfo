+    "div",
+    { class: "u-box" },
+    h("h3", {}, "Visual acuity"),
+    h("div", { class: "pair" }, h("span", {}, "Right"), input("va", "R", m.va.R, "e.g. 6/12")),
+    h("div", { class: "pair" }, h("span", {}, "Left"), input("va", "L", m.va.L, "e.g. 6/9")),
