+      b.end - b.start - (a.end - a.start) ||
+      a.start - b.start,
+  );
+  const kept = [];
+  for (const f of ranked) {
+    if (!kept.some((k) => f.start < k.end && k.start < f.end)) kept.push(f);
+  }
+  kept.sort((a, b) => a.start - b.start);
+  return kept.map((f, i) => ({ ...f, id: `${f.type}-${f.start}-${i}`, key: dismissKey(f) }));
